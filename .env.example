# ── LangSmith ────────────────────────────────────────────────────────────────
# A WORKSPACE-SCOPED API key (Settings → API Keys). A workspace-scoped key needs
# nothing else. An org-scoped key also requires LANGSMITH_WORKSPACE_ID (below).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# The tracing project the agent's runs land in (created automatically).
LANGSMITH_PROJECT=pov-support-agent
# Only set if your key is org-scoped (multi-workspace):
# LANGSMITH_WORKSPACE_ID=
# Override only for self-hosted / EU. Default: https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Model (provider-agnostic) ────────────────────────────────────────────────
# Format: "provider:model". The agent and the LLM-as-judge both use this.
# Examples: anthropic:claude-sonnet-4-6 | openai:gpt-5.1 | google_genai:gemini-2.5-flash
MODEL=openai:gpt-5.4-nano

# PHI/PII Level 2 — LangSmith LLM Gateway (centralized spend limits + gateway-side
# PII redaction). On by default in code; set false to call the provider directly.
USE_LANGSMITH_GATEWAY=false
LANGSMITH_GATEWAY_URL="https://gateway.smith.langchain.com/openai"
# Optional separate LangSmith key for gateway calls (defaults to LANGSMITH_API_KEY):
# LANGSMITH_API_KEY_GATEWAY=

# With the gateway off, set the key for whichever provider MODEL points at:
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Voice audio ──────────────────────────────────────────────────────────────
# Voice scenarios run through real audio: synthetic caller audio → speech-to-text
# → agent → text-to-speech. Needs an OpenAI key for the audio endpoints.
OPENAI_API_KEY=
VOICE_AUDIO=true
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# Caller audio can't be redacted, so it is never attached to traces unless you
# opt in. Only ever enable this with synthetic audio.
ATTACH_CALLER_AUDIO=false
